# Copy this file to .env and replace every value.
# Never commit .env.

SECRET_KEY=replace-with-a-long-random-string
STAFF_EMAIL=staff@example.com
STAFF_PASSWORD=replace-with-a-strong-password

# Optional
# APP_ENV=development
# On Render set APP_ENV=production. Render injects PORT; do not set it here.
# The process must listen on 0.0.0.0:$PORT (see scripts/start.sh). Python 3.12
# is pinned in .python-version because Render's default 3.14 cannot install
# the pinned packages.
# FLASK_DEBUG=0
# DATABASE_URL=sqlite:///instance/civic.db
# UPLOAD_FOLDER=instance/uploads
# ISSUE_CATEGORIES=pothole,garbage,streetlight,water,other
# MAP_DEFAULT_LAT=33.6844
# MAP_DEFAULT_LNG=73.0479
# COORDINATE_ROUNDING=3
# PAGE_SIZE=20
# STAFF_DEPARTMENT=Other
# DUPLICATE_RADIUS_M=40
# DUPLICATE_DAYS=30
# PHOTO_MIN_EDGE=64
# PHOTO_AI_ENABLED=false
# Use your own inboxes for tests — never a stranger's address.
# DEPT_EMAIL_ROADS=you+roads@example.com
# DEPT_EMAIL_SANITATION=you+sanitation@example.com
# DEPT_EMAIL_WATER=you+water@example.com
# DEPT_EMAIL_ELECTRIC=you+electric@example.com
# DEPT_EMAIL_OTHER=you+other@example.com
# EMAIL_BACKEND=console
# EMAIL_FOR_DEMO=false
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_TLS=true
# DEMO_MODE=false
# AUTO_CONFIRM_DAYS=7
# PUBLIC_PIN_LIMIT=200
# REMEMBER_COOKIE_DURATION_DAYS=30
# FIREBASE_PROJECT_ID=
# FIREBASE_WEB_API_KEY=
# FIREBASE_AUTH_DOMAIN=
# GOOGLE_APPLICATION_CREDENTIALS=
# FIREBASE_AUTH_EMULATOR_HOST=
